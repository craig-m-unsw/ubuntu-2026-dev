#cloud-config
#
# this yaml file is cloud-init data for Ubuntu LTS (edit as required)
# https://docs.cloud-init.io/en/latest/index.html
#
autoinstall:
  version: 1
  keyboard:
    layout: us
  identity:
    hostname: linuxdev
    username: sysadmin
    # command to generate the hash of user's password: mkpasswd --stdin <<< "ubuntu2026"
    password: "$y$j9T$s.Ush1PWBYHSRGmZMN5FC.$VYlLJHurnxOdbqosX0WoiHFoh3d9bNu4MchB2whGSb8"
  ssh:
    install-server: true
    emit_keys_to_console: false
    allow-pw: false
  storage:
    layout:
      name: lvm
      # the password is for full disk encryption. Comment out this line to disable full disk encryption.
      password: "secure-at-rest"
  user-data:
    timezone: Australia/Sydney
    locale: en_US.UTF-8
    # the post-install script is the better place to run apt update/upgrade.
    # this minimizes installer failures and keeps the bootstrap action predictable
    package_update: false
    package_upgrade: false
    write_files:
      - path: /etc/sudoers.d/90-sysadmin
        owner: 'root:root'
        permissions: '0440'
        content: |
          # allow sysadmin user to sudo (use root) without password
          sysadmin ALL=(ALL) NOPASSWD:ALL
          #
          # uncomment the following 2 lines to require password for sudo commands
          # changes the timestamp_timeout to 0 to require password for every sudo command
          #
          #Defaults timestamp_timeout=0
          #sysadmin ALL=(ALL:ALL) ALL
      - path: /etc/ansible/facts.d/aainstall.fact
        owner: 'root:root'
        permissions: '0755'
        content: |
          #!/usr/bin/env python3
          import json
          print(json.dumps({
            "prime_user" : "sysadmin",
            "ff_extrepo_enabled" : "true"
          }))
      # Runs on every boot
      - path: /var/lib/cloud/scripts/per-boot/hello-boot.sh
        owner: root:root
        permissions: '0755'
        content: |
          #!/usr/bin/env bash
          set -Eeuo pipefail
          echo "CTF{$(openssl rand -hex 32)}" > /tmp/flag.txt
          echo "hello-boot" | logger
      # Runs once during the lifetime of this machine
      - path: /var/lib/cloud/scripts/per-instance/hello-instance.sh
        owner: root:root
        permissions: '0755'
        content: |
          #!/usr/bin/env bash
          set -Eeuo pipefail
          echo "CTF{$(openssl rand -hex 32)}" > /root/flag.txt
          echo "hello-instance" | logger
      # the Setup script (run manually after the first boot)
      - path: /root/setup.sh
        owner: root:root
        permissions: '0755'
        content: |
          #!/usr/bin/env bash
          set -Eeuo pipefail
          echo "starting setup.sh" | logger
          apt-get update
          apt full-upgrade -y
          snap fresh
          apt-get install -y software-properties-common curl ansible python3 python3-pip python3-apt git apt-transport-https
          log_dir=$(mktemp -d /tmp/ansible-log.XXXXXX)
          log_file="$log_dir/ansible.log"
          echo "Ansible log: $log_file"
          ansible-playbook -i "localhost," -c local /root/playbook.yml -e prime_user=sysadmin -vv 2>&1 | tee "$log_file"
          echo "finished setup.sh" | logger
      - path: /root/playbook.yml
        owner: root:root
        permissions: '0644'
        encoding: b64
        content: |
          REPLACE_WITH_BASE64_ENCODED_ANSIBLE_PLAYBOOK_CONTENT
    runcmd:
      - logger "cloud-init runcmd ran"
    final_message: |
      Cloud-init completed successfully.
  output:
      init:
          output: "> /var/log/cloud-init.out"
          error: "> /var/log/cloud-init.err"
      config: "tee -a /var/log/cloud-config.log"
      final:
          - ">> /var/log/cloud-final.out"
          - "/var/log/cloud-final.err"
